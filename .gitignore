traceroute/

# --- python ---
__pycache__/
*.pyc
weather-cache.json
.claude-sandbox/
battery-history.jsonl

# machine-specific config BACKUPS — same secrets as /config, which is already ignored.
# A backup named config.bak-* leaked the live point, allow-list and greeting text to this PUBLIC
# repo on 2026-08-17 because /config matches only the exact name.
/config.bak*
/config.*.bak

# --- delivery receipts: every record names a real node id we sent to, and this repo is public
acks.jsonl

# --- passive traceroute harvest: third parties' node ids and topology, runtime data ---
routes.jsonl
traceroute-state.json

