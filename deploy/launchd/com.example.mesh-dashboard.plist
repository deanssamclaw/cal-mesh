<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.example.mesh-dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__HOME__/cal-mesh/dashboard.py</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>WorkingDirectory</key><string>__HOME__/cal-mesh</string>
    <key>StandardOutPath</key><string>__HOME__/cal-mesh/dashboard.log</string>
    <key>StandardErrorPath</key><string>__HOME__/cal-mesh/dashboard.log</string>
</dict>
</plist>
