#!/usr/bin/env bash
# cal-mesh helper — talk to Cal HT through the always-on bridge.
#   mesh send "text"              broadcast on ch0 (public)
#   mesh send -j '{"text":"hi","dest":"!aaaaaaaa","channel":0}'   raw JSON (DM/channel)
#   mesh read [N]                 last N inbox messages (default 15)
#   mesh watch                    live-tail incoming
#   mesh nodes                    neighbors heard (from nodes.json)
#   mesh status                   bridge + transport + port state
#   mesh log [N]                  last N bridge log lines
set -euo pipefail
BASE="$HOME/cal-mesh"
OUTBOX="$BASE/outbox"; INBOX="$BASE/inbox.jsonl"; LOG="$BASE/bridge.log"; NODES="$BASE/nodes.json"
cmd="${1:-status}"; shift || true

case "$cmd" in
  send)
    if [ "${1:-}" = "-j" ]; then payload="${2:?json required}";
    else payload="${*:?text required}"; fi
    name="msg.$(date +%s).$$"
    # write a dotfile temp (invisible to the bridge's glob) then atomically rename
    printf '%s' "$payload" > "$OUTBOX/.$name"
    mv "$OUTBOX/.$name" "$OUTBOX/$name"
    echo "queued -> $name"
    ;;
  read)
    n="${1:-15}"
    [ -f "$INBOX" ] || { echo "(no messages yet)"; exit 0; }
    tail -n "$n" "$INBOX" | python3 "$BASE/_fmt.py"
    ;;
  watch)
    touch "$INBOX"; tail -n 0 -f "$INBOX" | python3 "$BASE/_fmt.py"
    ;;
  status)
    echo "== launchd =="; launchctl print "gui/$(id -u)/com.cal.mesh-bridge" 2>/dev/null | grep -E 'state =|pid =' || echo "  not loaded"
    echo "== transport =="; grep -E '^(TRANSPORT|PORT|HOST)=' "$BASE/config"
    echo "== port owner =="; P=$(grep -E '^PORT=' "$BASE/config"|cut -d= -f2); lsof "$P" 2>/dev/null | tail -n +1 || echo "  (nothing on $P)"
    echo "== last log =="; tail -n 4 "$LOG" 2>/dev/null || echo "  (no log)"
    ;;
  nodes)
    [ -f "$NODES" ] || { echo "(no nodes yet)"; exit 0; }
    python3 - "$NODES" <<'PY'
import sys, json
d = json.load(open(sys.argv[1]))
ns = d.get("nodes", [])
print(f'{d.get("count", len(ns))} neighbors (as of {str(d.get("ts",""))[11:19]}):')
print(f'{"SHORT":<6} {"NAME":<22} {"HW":<16} {"HOP":>3} {"SNR":>6}')
for n in ns:
    hop = n.get("hops"); snr = n.get("snr")
    print(f'{str(n.get("short") or ""):<6} {str(n.get("long") or "")[:22]:<22} {str(n.get("hw") or "")[:16]:<16} {("-" if hop is None else str(hop)):>3} {("-" if snr is None else str(snr)):>6}')
PY
    ;;
  log) tail -n "${1:-30}" "$LOG" ;;
  *) echo "usage: mesh {send|read|watch|nodes|status|log}"; exit 1 ;;
esac
