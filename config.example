# cal-mesh config — copy this to `config` and fill in your own values.
# The real `config` is gitignored (machine-specific). The responder and dashboard re-read it on
# every pass; the BRIDGE reads it at start, so restart the bridge after changing TRANSPORT, PORT
# or HOST (launchctl kickstart -k gui/$(id -u)/<your bridge label>, or systemctl --user restart
# cal-mesh-bridge). The repo is expected at ~/cal-mesh: several scripts use that path.

# --- USB (most reliable while the node is plugged into this machine) ---
TRANSPORT=serial
PORT=/dev/cu.usbmodemXXXXXXXXXXXX   # macOS. Linux: /dev/serial/by-id/usb-... (stable across replugs; user in `dialout`). Set but absent = the bridge waits for it; empty = auto-detect

# --- WiFi (survives unplugging; node runs untethered on the LAN) ---
# Set TRANSPORT=tcp to use this. HOST is the node's mDNS name (survives DHCP changes).
# NOTE: the node must run a firmware build that serves the TCP API on 4403. The heavy
# touchscreen-UI build (LVGL "MUI" / *-tft on ESP32-S3) is compiled with the webserver
# EXCLUDED -> 4403 is refused even though WiFi is up. Use the plain BaseUI (non-tft)
# build, or point HOST at another node that serves 4403.
HOST=Meshtastic.local

# --- RESPONDER (Level 2: autonomous replies) ---
# MASTER KILL SWITCH. false = Cal transmits nothing on his own: no reply, no signal report, no
# greeting, no traceroute probe. Each of those also has its own flag. Manual `mesh send` works.
RESPONDER_ENABLED=false
RESPONDER_MODEL=claude-haiku-4-5-20251001
# Node IDs allowed to trigger a reply. ADVISORY ONLY — Meshtastic node IDs are
# unauthenticated/spoofable, so this is not a security boundary (see README/runbook).
ALLOW_FROM=!xxxxxxxx,!yyyyyyyy
TRIGGER_WORD=cal
RATE_MAX=5
RATE_WINDOW_S=600
COOLDOWN_S=8
MAX_AGE_S=300
GEN_TIMEOUT_S=90

# --- WEATHER capability (Level 3, Stage 1) — default OFF ---
# The harness fetches current conditions from NWS (api.weather.gov) and injects them as
# context; the model stays tool-locked and only narrates. See docs/proposals/level3-weather.md.
WEATHER_ENABLED=false
# 'lat,lon' of your PUBLIC reference point (the metro the mesh covers — NOT a private address).
WEATHER_POINT=39.0000,-95.0000
# Optional whitelist of named places callers may ask for: 'name:lat,lon;name2:lat,lon'.
# A named place NOT on this list is ignored (falls back to WEATHER_POINT) — closes the
# location-as-exfil path. Leave blank to only ever answer for the default point.
WEATHER_PLACES=
# NWS requires a User-Agent; a contact URL/email is polite.
WEATHER_UA=cal-mesh/1.0 (github.com/deanssamclaw/cal-mesh)
# Per-request fetch timeout (seconds). The station is cached, so steady state is one GET.
WEATHER_TIMEOUT_S=4

# --- greeting ack for OFF-LIST senders ---
# A bare greeting from a node that is NOT on ALLOW_FROM gets this fixed string back, so
# silence on a shared channel doesn't read as a snub. No model runs: the match SELECTS
# this reply, it never shapes it. Leave GREET_TEXT empty to keep the capability closed.
# NOTE: whatever you put here is broadcast in the clear and logged by every node in
# range, permanently. If it names a place, that place is public.
GREETING_ENABLED=false
GREET_TEXT=
GREET_MAX_PER_DAY=6
GREET_SENDER_COOLDOWN_S=86400

# --- P1 content unlock on an authenticated DM (docs/proposals/channel-trust-and-agency.md) ---
# Longer, context-aware replies to ONE pinned node over an authenticated direct message.
# CONTENT only — tools stay locked exactly as on the public channel.
# All four must be set or the unlock is closed. The key fingerprint is what an id-spoofer
# cannot supply; the node id alone is worth nothing.
DM_UNLOCK_ENABLED=false
DM_UNLOCK_NODE=
DM_UNLOCK_PUBKEY_FP=
DM_CONTEXT_FILE=
DM_CONTEXT_MAX_CHARS=2000
DM_MAX_CHARS=200

# Longer replies on AUTHENTICATED DMs, with NO unlock and NO injected context. Separate
# knob from DM_UNLOCK_ENABLED on purpose: this changes only the length budget, so it
# carries none of the unlock's disclosure risk. Requires: addressed to us + pki true.
# The persona keeps every restriction of the public one; only the 5-7 word cap relaxes.
DM_LONGER_ENABLED=false
DM_LOCKED_MAX_CHARS=180

# --- Level 3 COMPUTE doer: arithmetic, measurements, RF formula pack (default OFF) ---
# The model is NOT in the number path. Python computes AND formats; the reply is emitted as a
# fixed string, so no prompt and no model call happen on this path at all.
# Refuses rather than guesses: ambiguous units (gal/ton/cup), div-zero, unparseable input,
# anything over the cost bounds. Intent is a successful bounded parse, never "contains a number".
CALC_ENABLED=false
CALC_MAX_CHARS=160

# --- Level 3 COMPUTE doer: sun / moon / twilight (default OFF) ---
# Closed-form astronomy (NOAA solar equations; Meeus ch.48 for lunar phase). No network, no
# curation, no model in the number path — Python formats the whole reply. Measured against 43
# U.S. Naval Observatory published times: max error 43 s, median 15 s.
#
# Observer location is READ FROM WEATHER_POINT and is never taken from the message: a named
# place in the text cannot move the sun observer, because the reply would then disclose which
# whitelisted place the asker named. Times only — no coordinate ever appears in a reply.
#
# Be aware the ANSWER is itself a weak position fix: two replies from different seasons bound the
# observer to roughly 21 x 8 miles. That is looser than the observing station already named on
# every weather reply, so it discloses nothing new today — but revisit it if the station is ever
# withheld. Detail in the sunmoon.py module docstring.
#
# SUNMOON_TZ FAILS CLOSED. An unparseable zone refuses rather than falling back to UTC; a silent
# UTC fallback put a five-hours-wrong local time on air during review.
# Moonrise/moonset is NOT implemented and is refused explicitly rather than estimated.
SUNMOON_ENABLED=false
SUNMOON_TZ=America/Chicago
SUNMOON_MAX_CHARS=120

# --- traceroute (full path discovery) --------------------------------------------------
# Tier 1, harvesting paths from traceroute traffic Cal already receives, is always on and
# costs no airtime. These keys govern only ACTIVE probing, which transmits.
#
# Off by default. A traceroute is the most airtime Cal can spend for the least payload:
# roughly 5.7 s of channel occupancy across 8 transmissions for a 3-hop probe, because the
# request floods out and the reply floods back and every relay in earshot repeats both.
TRACEROUTE_ENABLED=false
# The politeness threshold is the FIRMWARE's, not one invented here:
# polite_channel_util_percent = 25 (airtime.h:71), which MeshService.cpp:99 uses to decide
# whether to volunteer NodeInfo -- the same category of self-initiated metadata. 40% is where
# the firmware stops sending anything at all, so 25 is the polite floor, not the hard one.
# Channel state is read live at send time and UNKNOWN MEANS DO NOT SEND.
TRACEROUTE_MAX_CH_UTIL=25
# One channel-utilization measurement window (6 x 10 s buckets, airtime.h:28). Not a
# politeness rule -- the gate above is that. This stops us reading a number that does not yet
# contain our own last probe.
TRACEROUTE_MIN_GAP_S=60
TRACEROUTE_HOP_LIMIT=3

# --- Neighbour position, published as a COARSE Maidenhead grid ---------------------------
# Nodes broadcast their own position over the air. This publishes a BUCKETED form of what
# they already transmit, never the point: the locator is computed at capture and the precise
# coordinate is never written to disk, so there is nothing exact for a later bug to serve.
# 6 = subsquare, ~3 x 4.5 miles at mid latitudes. 4 = square, ~70 x 110 miles (a whole metro
# in one bucket, which says nothing). Your own node is excluded whatever it advertises.
POSITION_GRID=true
POSITION_GRID_CHARS=6

# Drafts: simulate the reply Cal did NOT send. Never transmits. Public tab.
DRAFTS_ENABLED=false
DRAFTS_MAX_PER_RUN=40
DRAFTS_MAX_PER_DAY=120

# S1ROUTE — a second opinion on routing. Full runbook: docs/router.md. Shipped OFF here; the
# operator's own config armed it 2026-09-24. Asked ONLY when no doer claimed an addressed message
# and it is about to go to the model; never on an unlocked DM or a sanitizer-flagged message, and
# never on a DM or Cal's own channel unless S1_PRIVATE_OK=true. Acts only into weather, caps or
# sigreport, each of which keeps its own refusals. All S1_* keys are re-read on every loop pass:
# setting S1_ROUTE_ENABLED=false turns it off with no restart (after the batch in hand).
# Inline `# comments` after a value are ignored by the loader.
S1_ROUTE_ENABLED=false
S1_MIN_CONF=0.8         # confidence the scorer must reach before anything acts
S1_PRIVATE_OK=false     # DMs + Cal's channel: a second, separate decision
S1_REJECTS_MAX=3        # this many 4xx in a row counts as an outage and backs off

# Which scorer answers first: local | typesafe. An unrecognised value turns the router OFF.
#   local    = tools/system-one/ on your own Linux box (a frozen Qwen3.5-4B scored by SemIf):
#              ~13 s a decision on CPU, no key, no message text leaves the house.
#   typesafe = Jev, TypeSafe AI's cloud service: ~0.25 s, needs a key, sends the sanitized
#              message text to api.typesafe.ai. Model pinned to jev-1.13.0.
S1_BACKEND=typesafe
# The local scorer's TAILNET address (100.x). Never a MagicDNS hostname: on a host with Funnel
# enabled it resolves to the public relay, and the router would leave the tailnet.
S1_LOCAL_URL=http://127.0.0.1:8799/v1/systemone
S1_LOCAL_TIMEOUT_S=30   # wall-clock; three CPU forward passes, not a network hop
S1_BUSY_BACKOFF_S=120   # after the local scorer answers 503 (too hot, or already busy)
S1_TIMEOUT_S=2          # wall-clock bound on a cloud call
S1_BACKOFF_S=300        # after a failure or malformed answer, skip that scorer this long
# Jev API key: one line, the key only (issued at console.typesafe.ai/keys). chmod 600.
S1_KEY_FILE=~/.credentials/typesafe

# CLOUD BACKUP for the local scorer: none | typesafe. With `typesafe`, a message the local scorer
# could not answer (hot, busy, down, timed out, malformed) or that arrives while it is backed off
# is asked of Jev instead -- same floor, guards and walls. PUBLIC traffic only: a DM or Cal's
# channel never goes to the backup, whatever S1_PRIVATE_OK says. Every use is appended to
# s1-fallback.jsonl, counted on the capabilities page, and named in that message's trace.
# Cost: ~760 input tokens a call at $0.042 per million (2026-09-24), i.e. ~$0.00003.
S1_FALLBACK=none

# --- Keys the code reads that had no entry here (defaults shown; all OFF unless you arm them) ---
# SIGNAL REPORT: answers a radio check / range test / contact report with the radio's own
# numbers. Runs FIRST, for any sender. Needs RESPONDER_ENABLED=true as well as its own flag.
SIGREPORT_ENABLED=false
SIGREPORT_SENDER_COOLDOWN_S=30
SIGREPORT_MAX_PER_DAY=20
SIGREPORT_MAX_CHARS=64
SIGREPORT_MAX_CH_UTIL=25
SIGREPORT_STATUS_MAX_AGE_S=600
# RADIO AND MESH TERMS: "what's tropo?" answered verbatim from data/radio_kb.json, where every
# entry cites its source page. Definition questions about exactly one listed term, nothing else.
KB_ENABLED=false
KB_MAX_CHARS=120
# "What can you do": composed from the live flags.
CAPS_ENABLED=false
# STRANGERS: an off-list node that addresses Cal (his name, or a DM) gets calc, sun/moon and the
# capability list -- the offline answers with no model in their path -- and nothing else. Needs
# RESPONDER_ENABLED and each capability's own flag. The daily budget is the real control:
# node ids are spoofable, so the per-node cooldown is only good manners.
STRANGER_DOERS_ENABLED=false
STRANGER_SENDER_COOLDOWN_S=300
STRANGER_MAX_PER_DAY=24
# A follow-up question the model asked may be answered by the same node within the TTL.
CLARIFY_FOLLOWUP_ENABLED=false
CLARIFY_TTL_S=180
# Cal's own (PSK) channel index; every message on it is addressed to Cal. -1 = none.
CAL_CHANNEL=-1
# Weather observations older than this are refused, not narrated.
WEATHER_MAX_OBS_AGE_S=5400
# Remembered DM thread for the one unlocked node.
DM_MEMORY_ENABLED=false
DM_MEMORY_MAX_TURNS=8
DM_MEMORY_MAX_CHARS=1200

# --- PRESENCE: the occasional greeting or radio check on the channel (presence.py) ---
# Run by a timer every 30 min (deploy/). Off by default; also silent when RESPONDER_ENABLED is
# off. Rare by construction: a chance roll inside morning (07-10), afternoon (12-16) and evening
# (18-21) windows, a weekly cap, a minimum gap, never twice the same phrase, never into a
# conversation or a busy channel. The phrases are yours; keep them short. A place name here goes
# on air, so put it in your config only if you want it said.
PRESENCE_ENABLED=false
PRESENCE_MAX_PER_WEEK=3
PRESENCE_MAX_PER_DAY=1
PRESENCE_MIN_GAP_H=36
PRESENCE_CHANCE=0.08
PRESENCE_QUIET_S=900
PRESENCE_MAX_CH_UTIL=25
PRESENCE_CHANNEL=0
PRESENCE_MORNING=Morning Mesh
PRESENCE_AFTERNOON=Afternoon Mesh
PRESENCE_EVENING=Evening Mesh
PRESENCE_CHECK=Radio check. Anyone out there?
# The windows are on this clock, not the host's. Unparseable = silent.
PRESENCE_TZ=America/Chicago
# A radio status older than this means the bridge may be down: wait.
PRESENCE_STATUS_MAX_AGE_S=600
